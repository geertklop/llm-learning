# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# PostgreSQL connection parts. These are shared between Docker Compose
# (which uses POSTGRES_USER/PASSWORD/DB to initialise the database) and
# the Python app (which assembles the DSN from all five values).
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag

# Base URL of the Ollama HTTP API. The default assumes Ollama is running
# natively on this machine (recommended on macOS for Metal GPU access).
OLLAMA_HOST=http://localhost:11434

# Ollama model used to convert text into embedding vectors.
# nomic-embed-text produces 768-dimensional vectors and is fast and accurate.
EMBED_MODEL=nomic-embed-text

# Ollama model used to generate the final answer from retrieved context.
# Can be overridden at runtime via environment variable: LLM_MODEL=other:model uv run rag query "..."
LLM_MODEL=mistral:7b

# Number of documents retrieved from pgvector to pass as context to the LLM.
# Higher = more context, but also more tokens and slower inference.
TOP_K=5
